default_platform(:ios)

platform :ios do
  desc "Take App Store screenshots and add device frames and headlines (fastlane/screenshots)"
  lane :screenshots do
    capture_screenshots
    frame
  end

  desc "Frame existing screenshots with the headlines in screenshots/en-US/*.strings"
  lane :frame do
    # frameit's newest iPad frame is the 12.9-inch iPad Pro (4th generation, forced in
    # Framefile.json): same aspect ratio as 13-inch at 2048x2732, which App Store Connect accepts.
    Dir.glob("screenshots/*/iPad Pro 13-inch*.png").reject { |f| f.end_with?("_framed.png") }.each do |file|
      sh("sips", "-z", "2732", "2048", file, out: File::NULL)
    end
    frame_screenshots(path: "./fastlane/screenshots")
    framed_gallery
  end

  desc "Upload metadata and framed screenshots to App Store Connect (no binary, no review submission)"
  lane :upload_metadata do
    upload_to_app_store(force: true)
  end

  desc "Write screenshots/screenshots.html with the framed screenshots, by language and device"
  private_lane :framed_gallery do
    require "erb"
    dir = File.expand_path("screenshots", __dir__)
    sections = Dir.glob("#{dir}/*/").sort.map do |language_dir|
      language = File.basename(language_dir)
      devices = Dir.glob("#{language_dir}*_framed.png").sort
        .group_by { |file| File.basename(file)[/\A(.+?)-\d\d-/, 1] }
      [language, devices]
    end
    html = ERB.new(<<~'HTML', trim_mode: "-").result(binding)
      <!doctype html>
      <html lang="en">
      <head>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <title>App Store Screenshots</title>
      <style>
        body { margin: 0; padding: 24px; font: 15px -apple-system, system-ui, sans-serif; background: #f4f2f8; color: #121212; }
        h1 { font-size: 24px; margin: 0 0 4px; }
        h2 { font-size: 18px; margin: 32px 0 12px; }
        p { margin: 0; color: #666; }
        .row { display: flex; gap: 16px; overflow-x: auto; padding-bottom: 8px; }
        figure { margin: 0; flex: none; }
        img { height: 520px; border-radius: 12px; box-shadow: 0 2px 10px rgba(0, 0, 0, .12); display: block; }
        figcaption { margin-top: 6px; font-size: 13px; color: #666; }
        a { color: inherit; }
      </style>
      </head>
      <body>
      <h1>App Store Screenshots</h1>
      <p>Framed with headlines. Generated by <code>fastlane frame</code>; click a screenshot for full size.</p>
      <%- sections.each do |language, devices| -%>
      <%- devices.each do |device, files| -%>
      <h2><%= ERB::Util.h(device) %> · <%= ERB::Util.h(language) %></h2>
      <div class="row">
        <%- files.each do |file| -%>
        <%- path = "#{language}/#{ERB::Util.url_encode(File.basename(file))}" -%>
        <figure>
          <a href="<%= path %>"><img src="<%= path %>" alt="" loading="lazy"></a>
          <figcaption><%= ERB::Util.h(File.basename(file, "_framed.png").sub("#{device}-", "")) %></figcaption>
        </figure>
        <%- end -%>
      </div>
      <%- end -%>
      <%- end -%>
      </body>
      </html>
    HTML
    File.write("#{dir}/screenshots.html", html)
    UI.success("Framed screenshots: #{dir}/screenshots.html")
  end
end
