  "data": [
    {
      "filter": "iPad Pro 13-inch",
      "force_device_type": "iPad Pro (12.9-inch) (4th generation)",
      "font_scale_factor": 0.08
    },
    {
      "filter": "iPhone 17 Pro Max",
      "force_device_type": "iPhone 17 Pro Max"
    }
  ]
}
