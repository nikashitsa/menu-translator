{
  "device_frame_version": "latest",
  "default": {
    "keyword": {
      "font": "./fonts/SF-Pro-Display-Bold.otf",
      "color": "#FFFFFF"
    },
    "title": {
      "font": "./fonts/SF-Pro-Display-Medium.otf",
      "color": "#E9DDFF"
    },
    "background": "./background.jpg",
    "padding": 60,
    "title_min_height": "12%",
    "stack_title": true,
    "title_below_image": false,
